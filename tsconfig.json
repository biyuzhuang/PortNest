{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/components/AIChat.tsx",
    "src/components/ConnectionList.tsx",
    "src/components/DataImportExport.tsx",
    "src/components/DockerDashboard.tsx",
    "src/components/MetricsStrip.tsx",
    "src/components/QueryEditor.tsx",
    "src/components/ServerStatusPanel.tsx",
    "src/components/TableEditor.tsx",
    "src/utils/terminalManager.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
